# Existing host directory; Compose refuses to silently create a mistyped path.
WORKSPACE_PATH=

# Choose an unused node name and its full MagicDNS name (no scheme or port).
TAILSCALE_HOSTNAME=
TAILSCALE_DOMAIN=

# Generate a pre-authorized, non-ephemeral auth key in the Tailscale admin console.
# Keep the real key only in .env (gitignored).
TS_AUTHKEY=
